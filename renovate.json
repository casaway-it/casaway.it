{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["custom.regex"],
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Rome",
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": ["gohugoio/hugo"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Hugo version pinned in workflows (HUGO_VERSION) and CLAUDE.md",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^CLAUDE\\.md$/"],
      "matchStrings": [
        "HUGO_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "CI pins \\*\\*v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\*\\*"
      ],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases"
    }
  ]
}
